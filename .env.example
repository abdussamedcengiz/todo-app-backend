# Bu dosyayi kopyalayip ".env" adiyla kaydet ve degerleri doldur.
# .env ASLA git'e girmez (bkz. .gitignore).

# Ortam: development | test | production
#
# BU SATIRI YORUMDAN CIKARMA -- yerelde acik kalmali.
# Tanimsiz birakilirsa varsayilan "production" olur ve ayrintili
# hata mesajlarini goremezsin. Varsayilanin production olmasi
# kasitli: canlida unutulan bir ayar bilgi sizintisina donusmesin.
NODE_ENV=development

# Sunucunun dinleyecegi port. Render bu degiskeni KENDISI atar.
PORT=5000

# PostgreSQL baglanti adresi.
# Gelistirme: yerel PostgreSQL ya da "npm run db:up" ile acilan konteyner
#   -> postgresql://postgres:postgres@localhost:5434/testdb
# Canli: Neon'un verdigi adres (sslmode=require ile)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/testdb"

# JWT imzalama anahtari. EN AZ 32 KARAKTER olmali -- uygulama
# acilirken bu kural denetlenir, kisa bir anahtarla sunucu baslamaz.
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CANLIDA MUTLAKA FARKLI BIR DEGER KULLAN.
JWT_SECRET="buraya-en-az-32-karakterlik-rastgele-bir-metin-gelmeli"

# CORS: izin verilen arayuz adresleri, virgulle ayrilmis.
#
# Gelistirmede tanimsiz birakilabilir; varsayilan http://localhost:5173.
# CANLIDA ZORUNLU: NODE_ENV=production iken tanimsizsa sunucu acilmaz
# (config/env.ts). Boyle olmasaydi canli arayuz sessizce CORS'a takilirdi.
#
# Render'a girilecek deger yalnizca canli arayuzun adresi:
#   https://todo-app-frontend-puce-nine.vercel.app
CORS_ORIGINS="http://localhost:5173"
